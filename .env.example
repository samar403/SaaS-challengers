# ── Lathe environment ─────────────────────────────────────────────
# Claude powers the copilot, document ingestion and legacy-migration mapper.
# Leave blank to run in Offline mode (deterministic engines, no LLM calls).
ANTHROPIC_API_KEY=
# Override the model (defaults to claude-opus-5-5).
LATHE_MODEL=claude-opus-5-5

# SQLite file locally, or a Turso/libSQL URL in production.
DATABASE_URL=file:./data/lathe.db
DATABASE_AUTH_TOKEN=

# HMAC secret for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
