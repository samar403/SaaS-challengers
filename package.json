{
  "name": "lathe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf data && echo \"Database removed \u2014 it is re-created and re-seeded on next start.\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Lathe \u2014 the AI-native ERP for industrial companies (YC RFS: SaaS challengers)",
  "engines": {
    "node": ">=20.9"
  }
}
